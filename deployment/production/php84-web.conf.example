; REVIEW against actual production php8.3 oneid pool/INI before installing.
; Retains observed production capacity 10, does not claim capacity certification.
[oneid-web-prod84]
user = www-data
group = www-data
listen = /run/php/oneid-web-prod84.sock
listen.owner = www-data
listen.group = www-data
listen.mode = 0660
pm = dynamic
pm.max_children = 10
pm.start_servers = 2
pm.min_spare_servers = 1
pm.max_spare_servers = 3
pm.max_requests = 500
clear_env = yes
security.limit_extensions = .php
php_admin_flag[display_errors] = off
php_admin_flag[log_errors] = on
php_admin_value[error_log] = /var/log/oneid-web-prod84-error.log
php_admin_value[memory_limit] = 512M
php_admin_value[max_execution_time] = 120
php_admin_value[post_max_size] = 100M
php_admin_value[upload_max_filesize] = 100M
php_admin_value[date.timezone] = Asia/Kuala_Lumpur
php_admin_value[session.gc_maxlifetime] = 28800
php_admin_flag[session.cookie_secure] = on
php_admin_flag[session.cookie_httponly] = on
