location = /.well-known/openid-configuration {
    allow 127.0.0.1;
    allow ::1;
    deny all;
    error_log /dev/null crit; # query-bearing nginx errors suppressed; use dedicated FPM log
    client_max_body_size 64k;
    access_log /var/log/nginx/oneid-mobile-prod.access.log oneid_mobile_safe;
    proxy_pass http://127.0.0.1:24144;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
}
