# DORMANT production template: include inside the existing production HTTPS server.
# Keep loopback-only until activation. Remove allow/deny ONLY for public routes; token-hook stays private.
# Dedicated FPM socket must exist before installation; hosted enabled=false remains required.
location = /login {
    allow 127.0.0.1;
    allow ::1;
    deny all;
    error_log /dev/null crit; # query-bearing nginx errors suppressed; use dedicated FPM log
    client_max_body_size 64k;
    access_log /var/log/nginx/oneid-mobile-prod.access.log oneid_mobile_safe;
    include /etc/nginx/fastcgi_params;
    fastcgi_param SCRIPT_FILENAME /var/www/oneid/mobile-public/index.php;
    fastcgi_param HTTPS on;
    fastcgi_param HTTP_PROXY "";
    fastcgi_pass unix:/run/php/oneid-mobile-prod84.sock;
    fastcgi_intercept_errors off;
}
