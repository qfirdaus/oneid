# REVIEW ONLY: include inside existing staging HTTPS server; do not create a duplicate server.
# Pilot remains loopback-only until an explicit access policy is configured.
# Dedicated FPM socket must exist before installation; hosted enabled=false remains required.
location = /login {
    allow 127.0.0.1;
    allow ::1;
    deny all;
    client_max_body_size 64k;
    access_log /var/log/nginx/oneid-mobile-uat.access.log oneid_safe;
    include /etc/nginx/fastcgi_params;
    fastcgi_param SCRIPT_FILENAME /var/www/oneid-uat/mobile-public/index.php;
    fastcgi_param HTTPS on;
    fastcgi_param HTTP_PROXY "";
    fastcgi_pass unix:/run/php/oneid-mobile-uat.sock;
    fastcgi_intercept_errors off;
}
