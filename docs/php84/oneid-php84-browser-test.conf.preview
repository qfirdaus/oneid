# Managed by OneID php84_browser_listener.py; loopback only.
log_format oneid_php84_test escape=json '{"time":"$time_iso8601","method":"$request_method","status":$status,"upstream":"$upstream_addr","seconds":"$request_time"}';
server {
    listen 127.0.0.1:24484 ssl http2;


    server_name oneid-uat.upnm.edu.my;

    root /var/www/oneid-uat/public;
    index index.php index.html;

    # SSL
    ssl_certificate     /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/upnm.key;

    # Logs
    access_log /var/log/nginx/oneid-php84-browser-test.access.log oneid_php84_test;
    error_log /dev/null crit;

    # Gunakan halaman khas untuk semua 404 yang dijana oleh Nginx.
    # Status HTTP akan kekal sebagai 404.
    error_page 404 /errors/404.html;

    # Halaman 404 hanya boleh digunakan secara dalaman oleh Nginx.
    location = /errors/404.html {
        internal;
    }

    # Basic security headers.
    # Application turut menghantar sebahagian header ini.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Block hidden files seperti .git dan .env.
    location ~ /\. {
        deny all;
    }

    # Jangan benarkan private/project paths jatuh ke front controller.
    location ~* ^/(?:README(?:\.md)?|package(?:-lock)?\.json|bower\.json|Gruntfile\.js|sso_db\.sql|docs(?:/.*)?|cron(?:/.*)?|bootstrap(?:/.*)?|config(?:/.*)?|deployment(?:/.*)?|resources(?:/.*)?|storage(?:/.*)?|tests?(?:/.*)?|tools(?:/.*)?|diag(?:/.*)?|test\.php|atest\.php)$ {
        return 404;
    }

    # Block executable/script files dalam upload directories.
    location ~* ^/(?:public_img|public_docs|videos)/.*\.(?:php[0-9]?|phtml|phar|cgi|pl|py|sh|bash)$ {
        return 404;
    }

    # Block executable/script files dalam static asset directories.
    location ~* ^/(?:assetsM|dist|img|vendors)/.*\.(?:php[0-9]?|phtml|phar|cgi|pl|py|sh|bash)$ {
        return 404;
    }

    # Managed staging test routes; existing HTTPS server only.
# Open staging: external routes available; token hook remains loopback-only.
# Feature state is controlled by the private staging adapter configuration.
location = /login {
    client_max_body_size 64k;
    error_log /dev/null crit;
    access_log /var/log/nginx/oneid-php84-browser-test.access.log oneid_php84_test;

fastcgi_param  QUERY_STRING       $query_string;
fastcgi_param  REQUEST_METHOD     $request_method;
fastcgi_param  CONTENT_TYPE       $content_type;
fastcgi_param  CONTENT_LENGTH     $content_length;

fastcgi_param  SCRIPT_NAME        $fastcgi_script_name;
fastcgi_param  REQUEST_URI        $request_uri;
fastcgi_param  DOCUMENT_URI       $document_uri;
fastcgi_param  DOCUMENT_ROOT      $document_root;
fastcgi_param  SERVER_PROTOCOL    $server_protocol;
fastcgi_param  REQUEST_SCHEME     $scheme;
fastcgi_param  HTTPS              $https if_not_empty;

fastcgi_param  GATEWAY_INTERFACE  CGI/1.1;
fastcgi_param  SERVER_SOFTWARE    nginx/$nginx_version;

fastcgi_param  REMOTE_ADDR        $remote_addr;
fastcgi_param  REMOTE_PORT        $remote_port;
fastcgi_param  REMOTE_USER        $remote_user;
fastcgi_param  SERVER_ADDR        $server_addr;
fastcgi_param  SERVER_PORT        443;
fastcgi_param  SERVER_NAME        $server_name;

# PHP only, required if PHP was built with --enable-force-cgi-redirect
fastcgi_param  REDIRECT_STATUS    200;

    fastcgi_param SCRIPT_FILENAME /var/www/oneid-uat/mobile-public/index.php;
    fastcgi_param HTTPS on;
    fastcgi_param HTTP_PROXY "";
    fastcgi_pass unix:/run/php/oneid-mobile-uat84.sock;
        add_header X-OneID-Test-Runtime "php84-isolated" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    fastcgi_intercept_errors off;
}
